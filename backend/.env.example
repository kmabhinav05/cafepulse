# ==============================================================================
# CafePulse Backend Environment Configuration
# ==============================================================================

PROJECT_NAME="CafePulse API"
API_V1_STR="/api"
SECRET_KEY="cafepulse_super_secret_jwt_key_replace_in_production_with_64_chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection:
# For local PostgreSQL 18:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cafepulse"
# SQLite alternative for instant zero-config testing:
# DATABASE_URL="sqlite:///./cafepulse.db"

# CORS Allowed Origins (Comma separated)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Demo Credentials
DEMO_ADMIN_EMAIL="admin@cafepulse.demo"
DEMO_ADMIN_PASSWORD="admin123"
DEMO_STAFF_EMAIL="staff@cafepulse.demo"
DEMO_STAFF_PASSWORD="staff123"
